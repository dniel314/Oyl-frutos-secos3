# =====================================================================
# OYL Frutos Secos — variables de entorno (plantilla)
# ---------------------------------------------------------------------
# 1. Copiar este archivo como .env en la raíz del proyecto:
#       cp .env.example .env
# 2. Cambiar TODAS las contraseñas y secretos antes de usar el proyecto.
# 3. El archivo .env NO se versiona (ver .gitignore).
# ---------------------------------------------------------------------
# Cada microservicio tiene su PROPIA instancia PostgreSQL, con su propio
# contenedor, usuario, contraseña y volumen. No se comparten bases ni esquemas.
# =====================================================================

# --- Puertos publicados en el host (cambiar si hay conflictos locales) ---
PORT_GATEWAY=8080
PORT_EUREKA=8761
PORT_MS_USUARIOS=8081
PORT_MS_PRODUCTOS=8082
PORT_MS_VENTAS=8083
PORT_MS_CORE=8084

# Puertos externos de cada PostgreSQL (uno por instancia)
PORT_DB_USUARIOS=5433
PORT_DB_PRODUCTOS=5434
PORT_DB_VENTAS=5435
PORT_DB_CORE=5436

# --- PostgreSQL · ms-usuarios (contenedor postgres-usuarios) ---
DB_USUARIOS_NAME=oyl_usuarios
DB_USUARIOS_USER=oyl_usuarios
DB_USUARIOS_PASSWORD=cambiar-clave-usuarios
DB_USUARIOS_URL=jdbc:postgresql://postgres-usuarios:5432/oyl_usuarios

# --- PostgreSQL · ms-productos (contenedor postgres-productos) ---
DB_PRODUCTOS_NAME=oyl_productos
DB_PRODUCTOS_USER=oyl_productos
DB_PRODUCTOS_PASSWORD=cambiar-clave-productos
DB_PRODUCTOS_URL=jdbc:postgresql://postgres-productos:5432/oyl_productos

# --- PostgreSQL · ms-ventas (contenedor postgres-ventas) ---
DB_VENTAS_NAME=oyl_ventas
DB_VENTAS_USER=oyl_ventas
DB_VENTAS_PASSWORD=cambiar-clave-ventas
DB_VENTAS_URL=jdbc:postgresql://postgres-ventas:5432/oyl_ventas

# --- PostgreSQL · ms-core (contenedor postgres-core) ---
DB_CORE_NAME=oyl_core
DB_CORE_USER=oyl_core
DB_CORE_PASSWORD=cambiar-clave-core
DB_CORE_URL=jdbc:postgresql://postgres-core:5432/oyl_core

# --- Eureka / descubrimiento interno (nombres DNS de Docker) ---
EUREKA_URI=http://eureka-server:8761/eureka/

# --- ms-core: seguridad y archivos ---
# OYL_JWT_SECRET debe tener 32 caracteres o más (HMAC-SHA256).
OYL_JWT_SECRET=cambiar-por-un-secreto-aleatorio-de-32-o-mas-caracteres
OYL_ADMIN_PASSWORD=cambiar-clave-admin-demo
OYL_DEMO_SEED=true

# --- Perfil Spring de los servicios Maven (prod por defecto en Docker) ---
SPRING_PROFILES_ACTIVE=prod
